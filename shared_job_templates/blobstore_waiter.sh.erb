function try_to_curl {
    local url=$1
    local max_attempts=$2
    local interval_in_seconds=$3

    curl -s -k "$url" >/dev/null

    found=$?
    blobstore_check_attempts=0

    while [ $found -ne 0 ]
    do
        sleep $interval_in_seconds
        blobstore_check_attempts=$((blobstore_check_attempts+1))

        curl -s -k "$url" >/dev/null
        found=$?

        if [[ blobstore_check_attempts -eq $max_attempts ]]; then
            echo "Blobstore is not available"
            exit 1
        fi
    done
}

function wait_for_blobstore {
    max_attempts=30
    sleep_length=1

    <% endpoint = (p('cc.buildpacks.connection_config', nil) || {}).fetch('private_endpoint', '').to_s %>
    <% internal_hostname = p('blobstore.internal_hostname', 'blobstore.service.cf.internal').to_s %>
    <% internal_singleton_blobstore = endpoint.match?(%r{\Ahttps?://#{Regexp.escape(internal_hostname)}(?::\d+)?(?:/.*|\z)}) %>
    <% if p('cc.buildpacks.blobstore_provider', nil) == 'dav' && internal_singleton_blobstore %>

    echo "Checking for blobstore availability"
    try_to_curl "<%= endpoint %>" $max_attempts $sleep_length
    echo "Blobstore is available"

    <% end %>
}
