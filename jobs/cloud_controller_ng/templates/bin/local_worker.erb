#!/usr/bin/env bash

source /var/vcap/jobs/cloud_controller_ng/bin/ruby_version.sh
source /var/vcap/jobs/cloud_controller_ng/bin/blobstore_waiter.sh

wait_for_blobstore

<% if p('cc.experimental.use_yjit_compiler') %>
export RUBYOPT='--yjit'
<% end %>

export LD_PRELOAD=/var/vcap/packages/jemalloc/lib/libjemalloc.so

<% num_threads = p("cc.jobs.local.number_of_worker_threads", nil) %>
<% thread_grace_period = p("cc.jobs.local.worker_thread_grace_period_seconds") %>

cd /var/vcap/packages/cloud_controller_ng/cloud_controller_ng
exec bundle exec rake "jobs:local[cc_api_worker.<%= spec.job.name %>.<%= spec.index %>.${INDEX}<%= ",#{num_threads},#{thread_grace_period}" if num_threads %>]"
