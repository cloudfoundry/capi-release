<%
  local_blobstore = %w[packages droplets buildpacks resource_pool].any? { |type| p("cc.#{type}.blobstore_type") == 'local' }

  # Allowlist: only the locations below proxy to CC; everything else 404s via the catch-all.
  # Allow blocks are plain-prefix / exact (never ^~) so the upload/ssh_access regex locations
  # keep precedence over them.
  # Indentation: 2 spaces for all but the first line -> nginx config renders nicely
  proxy_body = +<<~PROXY
    access_log  /var/vcap/sys/log/cloud_controller_ng/nginx-access.log main;
      proxy_buffering             off;
      proxy_set_header            Host $host;
      proxy_set_header            X-Real_IP $remote_addr;
      proxy_set_header            X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_redirect              off;
      proxy_connect_timeout       10;
      proxy_pass                  http://cloud_controller;
  PROXY
  # base_proxy = proxy body without the general limit. Per-path zones below get their own limit only
  base_proxy = proxy_body.dup
  if_p('cc.nginx_rate_limit_general') do |general|
    proxy_body << "  limit_req zone=all burst=#{general['burst']} nodelay;\n"
  end
%>

<% if_p("cc.nginx_rate_limit_zones") do %>
# Per-path rate-limit zones
# Note: bad zone config can open access to unwanted paths and override required config (e.g. for uploads)
  <% p("cc.nginx_rate_limit_zones").each do |zone| %>
location <%= zone['location'] %> {
  <%= base_proxy -%>
  limit_req zone=<%= zone['name'] %> burst=<%= zone['burst'] %> nodelay;
}
  <% end %>
<% end %>

# Standard CF API paths
location = / {
  <%= proxy_body -%>
}

location = /v3 {
  <%= proxy_body -%>
}

location /v3/ {
  <%= proxy_body -%>
}

<% if p("cc.temporary_enable_v2") %>
location = /v2 {
  <%= proxy_body -%>
}

location /v2/ {
  <%= proxy_body -%>
}

location ~ /v2/apps/[^/]+/bits {
  if ($arg_application_path) { return 422; }

  include public_upload.conf;

  upload_pass_args on;
  upload_pass_form_field "^resources$";
}

location ~ /v2/buildpacks/.*/bits {
  if ($arg_buildpack_path) { return 422; }

  include public_upload.conf;
}

location ~ /v2/apps/[^/]+/droplet/upload {
  if ($arg_droplet_path) { return 422; }

  include public_upload.conf;
}
<% end %>

location = /v2/info {
  <%= proxy_body -%>
}

location ~ /v3/packages/.*/upload {
  if ($arg_bits_path) { return 422; }

  upload_pass_form_field "^resources$";
  include public_upload.conf;
}

location ~ /v3/buildpacks/.*/upload {
  if ($arg_bits_path) { return 422; }

  include public_upload.conf;
}

location ~ /v3/droplets/.*/upload {
  if ($arg_bits_path) { return 422; }

  include public_upload.conf;
}

# Pass altered request body to a backend
location @cc_uploads {
  proxy_pass http://cloud_controller;
}

# Public /internal path (OAuth, in-app): ssh-proxy uses it for `cf ssh`.
location ~ ^/internal/apps/[^/]+/ssh_access/ {
  <%= proxy_body -%>
}

<% if local_blobstore %>
location /staging/ {
  <%= proxy_body -%>
}
<% end %>

location = /healthz {
  <%= proxy_body -%>
}

location /nginx_status {
  stub_status on;

  access_log  /var/vcap/sys/log/cloud_controller_ng/nginx_status.access.log main;

  allow 127.0.0.1;
  deny all;
}

# Deny by default: anything not explicitly allowed above.
location / {
  access_log  /var/vcap/sys/log/cloud_controller_ng/nginx-access.log main;
  default_type application/json;
  return 404 '{"errors":[{"detail":"Unknown request","title":"CF-NotFound","code":10000}]}';
}
