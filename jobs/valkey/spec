---
name: valkey

description: "Co-deployed Valkey used for rate limiting and metrics"

templates:
  bpm.yml.erb: config/bpm.yml
  pre-start.sh.erb: bin/pre-start.sh
  valkey-cli.sh.erb: bin/valkey-cli.sh
  drain.sh.erb: bin/drain

packages:
  - valkey

consumes:
  - name: cloud_controller_internal
    type: cloud_controller_internal

properties:
  valkey.drain_timeout:
    description: "Maximum seconds valkey's drain waits for co-located cloud_controller_ng to stop. If CC-NG has not exited within this time, valkey stops anyway so the deploy cannot hang indefinitely."
    default: 60
